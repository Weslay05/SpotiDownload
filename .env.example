OUTPUT_DIRECTORY="assets/output"
METADATA_FROM="youtube" # Options [youtube]
AUDIO_CONTAINER="opus" # Tested Options [flac, opus]

OUTPUT_BITRATE="128" # in kbit/s
MAX_DOWNLOAD_TRIES=5
MAX_YOUTUBE_RESULTS=5

LOUDNESS_LUFS="-14" # LUFS
LOUDNESS_PEAK_DBFS="-0.5" # dBFS for higher dynamic range
LOUDNESS_RANGE_LRA="14.0" # 0-50 ffmpeg `LRA`